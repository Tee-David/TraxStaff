{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trax",
  "version": "0.1.0",
  "identifier": "com.trax.tracker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Trax",
        "width": 420,
        "height": 640,
        "resizable": true,
        "minWidth": 340,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3099 https://trax-backend-ocaq.onrender.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
