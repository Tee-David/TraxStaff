{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trax",
  "version": "0.1.0",
  "identifier": "com.trax.tracker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Trax",
        "width": 420,
        "height": 640,
        "resizable": true,
        "minWidth": 340,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:3099 https://trax-backend-ocaq.onrender.com; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "WDC Solutions",
    "copyright": "© 2026 Wendiloveee Media. All rights reserved. Developed by WDC Solutions.",
    "licenseFile": "EULA.txt",
    "homepage": "https://deo-trax.vercel.app",
    "shortDescription": "Trax — time tracking & productivity",
    "longDescription": "Trax is an internal time-tracking and productivity tool: time tracking, activity metrics, periodic screenshots, projects and tasks, and team reporting. Owned by Wendiloveee Media; developed by WDC Solutions.",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "both",
        "displayLanguageSelector": true,
        "languages": ["English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Tee-David/trax/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxNjY2REJEOTk4MDkwRTcKUldUbmtJQ1p2VzFtd1lPUXJQUlNlbmRiWEFkdkVITG40K1BKK3dNSkZLalErdjhoaHV5blZNN1IK"
    }
  }
}
