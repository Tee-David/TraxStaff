generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  member
}

enum UserStatus {
  invited
  active
  disabled
}

enum TaskStatus {
  todo
  in_progress
  done
}
enum TaskPriority {
  lowest
  normal
  urgent
}

enum SessionEndReason {
  stopped
  idle_timeout
  abrupt_exit
}

enum FlagType {
  sustained_high_activity
  low_variance_robotic
  input_channel_imbalance
  jiggler_process_detected
  // The device's wall clock moved out of step with its own monotonic clock —
  // i.e. the system time was changed during tracking.
  clock_skew_detected
  // A batch claimed more work time than actually elapsed on the server between
  // two contacts. The client cannot see or influence either endpoint, so this is
  // the strongest signal available.
  exceeds_elapsed_cap
  // Activity blocks timestamped outside their own session's window.
  block_outside_session_window
}

model Organization {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  createdAt     DateTime       @default(now())
  // Screenshot capture policy (admin-configurable, org-wide)
  screenshotsPerBlock Int      @default(1) // 0 = off, 1/2/3 per 10-min block
  blurScreenshots     Boolean  @default(false)
  idleTimeoutMinutes  Int      @default(5)
  keepIdleDefault     Boolean  @default(true)
  // Org-wide work targets. Members inherit these unless given their own.
  dailyTargetMinutes  Int      @default(480)
  weeklyTargetMinutes Int      @default(2400)
  users         User[]
  projects      Project[]
  invites       InviteToken[]
  notifications Notification[]
}

model User {
  id                 String            @id @default(uuid()) @db.Uuid
  orgId              String            @db.Uuid
  org                Organization      @relation(fields: [orgId], references: [id])
  email              String            @unique
  passwordHash       String?
  role               Role              @default(member)
  status             UserStatus        @default(invited)
  consentAcceptedAt  DateTime?
  consentVersion     Int?
  // Per-member overrides. Null means "inherit the org target" — distinct from 0,
  // which is a real target of no hours (someone on leave).
  dailyTargetMinutes  Int?
  weeklyTargetMinutes Int?
  createdAt          DateTime          @default(now())
  devices            Device[]
  sessions           TrackingSession[]
  notifications      Notification[]
  timeNotes          TimeNote[]
  deletedScreenshots Screenshot[]      @relation("ScreenshotDeletedBy")
  passwordResets     PasswordResetToken[]

  @@index([orgId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model InviteToken {
  id         String       @id @default(uuid()) @db.Uuid
  orgId      String       @db.Uuid
  org        Organization @relation(fields: [orgId], references: [id])
  email      String
  role       Role
  token      String       @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([orgId])
}

model Project {
  id         String            @id @default(uuid()) @db.Uuid
  orgId      String            @db.Uuid
  org        Organization      @relation(fields: [orgId], references: [id])
  name       String
  clientTag  String?
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  tasks      Task[]
  sessions   TrackingSession[]

  @@index([orgId])
}

model Task {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @db.Uuid
  project   Project           @relation(fields: [projectId], references: [id])
  title     String
  status    TaskStatus        @default(todo)
  priority  TaskPriority      @default(normal)
  dueDate   DateTime?
  createdAt DateTime          @default(now())
  sessions  TrackingSession[]

  @@index([projectId])
}

model Device {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @db.Uuid
  user       User              @relation(fields: [userId], references: [id])
  platform   String
  appVersion String
  lastSeenAt DateTime          @default(now())
  createdAt  DateTime          @default(now())
  sessions   TrackingSession[]

  @@index([userId])
}

model TrackingSession {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @db.Uuid
  user            User              @relation(fields: [userId], references: [id])
  projectId       String            @db.Uuid
  project         Project           @relation(fields: [projectId], references: [id])
  taskId          String?           @db.Uuid
  task            Task?             @relation(fields: [taskId], references: [id])
  deviceId        String            @db.Uuid
  device          Device            @relation(fields: [deviceId], references: [id])
  startedAt       DateTime
  endedAt         DateTime?
  endReason       SessionEndReason?
  isManual        Boolean           @default(false)
  manualReason    String?
  tamperSuspected Boolean           @default(false)
  // Last time this session's device successfully synced. The server-witnessed
  // elapsed cap is measured from here, so it must be set from the server clock
  // only — never from anything the client sends.
  lastSyncAt      DateTime?
  createdAt       DateTime          @default(now())
  activityBlocks  ActivityBlock[]
  screenshots     Screenshot[]
  flags           UnusualActivityFlag[]
  appUsages       AppUsage[]
  urlUsages       UrlUsage[]
  idleDiscards    IdleDiscard[]
  notes           TimeNote[]

  @@index([userId])
  @@index([projectId])
  @@index([deviceId])
}

model AppUsage {
  id         String          @id @default(uuid()) @db.Uuid
  sessionId  String          @db.Uuid
  session    TrackingSession @relation(fields: [sessionId], references: [id])
  appName    String
  seconds    Int
  blockStart DateTime
  createdAt  DateTime        @default(now())

  @@unique([sessionId, blockStart, appName])
  @@index([sessionId])
}

model UrlUsage {
  id         String          @id @default(uuid()) @db.Uuid
  sessionId  String          @db.Uuid
  session    TrackingSession @relation(fields: [sessionId], references: [id])
  domain     String
  seconds    Int
  blockStart DateTime
  createdAt  DateTime        @default(now())

  @@unique([sessionId, blockStart, domain])
  @@index([sessionId])
}

model IdleDiscard {
  id        String          @id @default(uuid()) @db.Uuid
  sessionId String          @db.Uuid
  session   TrackingSession @relation(fields: [sessionId], references: [id])
  from      DateTime
  to        DateTime
  seconds   Int
  createdAt DateTime        @default(now())

  @@index([sessionId])
}

model TimeNote {
  id        String          @id @default(uuid()) @db.Uuid
  sessionId String          @db.Uuid
  session   TrackingSession @relation(fields: [sessionId], references: [id])
  userId    String          @db.Uuid
  user      User            @relation(fields: [userId], references: [id])
  body      String
  createdAt DateTime        @default(now())

  @@index([sessionId])
}

model ActivityBlock {
  id          String          @id @default(uuid()) @db.Uuid
  sessionId   String          @db.Uuid
  session     TrackingSession @relation(fields: [sessionId], references: [id])
  blockStart  DateTime
  blockEnd    DateTime
  keyboardPct Float
  mousePct    Float
  activityPct Float
  idleSeconds Int             @default(0)
  sequenceNo  Int
  prevHash    String
  hash        String
  // Monotonic timing from the client's tamper-resistant clock. `creditedSeconds`
  // is awake time only and is immune to system-clock changes; `suspendedSeconds`
  // is time asleep (recorded, never credited); `clockSkewSeconds` is how far the
  // wall clock drifted against the monotonic counter. Nullable for blocks synced
  // by clients predating this.
  creditedSeconds  Int?
  suspendedSeconds Int?
  clockSkewSeconds Int?
  createdAt   DateTime        @default(now())
  screenshots Screenshot[]

  @@unique([sessionId, sequenceNo])
  @@index([sessionId])
}

model Screenshot {
  id              String        @id @default(uuid()) @db.Uuid
  sessionId       String        @db.Uuid
  session         TrackingSession @relation(fields: [sessionId], references: [id])
  activityBlockId String        @db.Uuid
  activityBlock   ActivityBlock @relation(fields: [activityBlockId], references: [id])
  takenAt         DateTime
  monitorIndex    Int
  r2Key           String
  blurred         Boolean       @default(false)
  deletedAt       DateTime?
  deletedById     String?       @db.Uuid
  deletedBy       User?         @relation("ScreenshotDeletedBy", fields: [deletedById], references: [id])
  createdAt       DateTime      @default(now())

  @@index([sessionId])
  @@index([activityBlockId])
  // Gallery paging is a keyset scan on (takenAt desc, id desc) — without this
  // every page is a full sort of the org's screenshot history.
  @@index([takenAt, id])
}

model UnusualActivityFlag {
  id             String          @id @default(uuid()) @db.Uuid
  sessionId      String          @db.Uuid
  session        TrackingSession @relation(fields: [sessionId], references: [id])
  type           FlagType
  detectedAt     DateTime        @default(now())
  details        Json?
  acknowledgedAt DateTime?

  @@index([sessionId])
}

model Notification {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @db.Uuid
  org       Organization @relation(fields: [orgId], references: [id])
  userId    String?      @db.Uuid
  user      User?        @relation(fields: [userId], references: [id])
  type      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([orgId])
  @@index([userId])
}
