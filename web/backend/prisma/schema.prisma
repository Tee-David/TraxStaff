generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  admin
  member
}

enum UserStatus {
  invited
  active
  disabled
  // DEPRECATED — no longer settable, and nothing produces it.
  //
  // This used to be the way a member was "removed": the row stayed forever so
  // its tracking history kept an owner, and the email was tombstoned to free
  // the address. Removing a member is now a real DELETE of the row; the history
  // survives because every userId FK is nullable + ON DELETE SET NULL, and
  // org-wide queries reach an orphaned session through its project instead (see
  // lib/org-scope.ts). Who removed whom lives in AuditLog.
  //
  // Kept only so the rows written before that change still read back.
  removed
}

enum TaskStatus {
  todo
  in_progress
  done
}
enum TaskPriority {
  lowest
  normal
  urgent
}

enum SessionEndReason {
  stopped
  idle_timeout
  abrupt_exit
}

enum FlagType {
  sustained_high_activity
  low_variance_robotic
  input_channel_imbalance
  jiggler_process_detected
  // The device's wall clock moved out of step with its own monotonic clock —
  // i.e. the system time was changed during tracking.
  clock_skew_detected
  // A batch claimed more work time than actually elapsed on the server between
  // two contacts. The client cannot see or influence either endpoint, so this is
  // the strongest signal available.
  exceeds_elapsed_cap
  // Activity blocks timestamped outside their own session's window.
  block_outside_session_window
}

model Organization {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  createdAt     DateTime       @default(now())
  // Screenshot capture policy (admin-configurable, org-wide)
  screenshotsPerBlock Int      @default(1) // 0 = off, 1/2/3 per 10-min block
  blurScreenshots     Boolean  @default(false)
  idleTimeoutMinutes  Int      @default(5)
  keepIdleDefault     Boolean  @default(true)
  // Whether the Reports page surfaces the per-domain "Website usage" panel.
  // Capture is unaffected either way — the desktop tracker keeps recording
  // UrlUsage, so flipping this back on reveals the full history rather than
  // starting from an empty panel.
  showWebsiteUsage    Boolean  @default(true)
  // Org-wide work targets. Members inherit these unless given their own.
  dailyTargetMinutes  Int      @default(480)
  weeklyTargetMinutes Int      @default(2400)
  // IANA zone the org's working days are measured in. Day and week boundaries
  // are wall-clock local, so without this a UTC+1 org credits an hour of Monday
  // morning to Sunday and the Monday digest under-reports it.
  timezone            String   @default("UTC")
  // Master switch for all non-essential email. Invites and password resets are
  // deliberately NOT covered — turning those off locks people out of the
  // account with no way back in.
  emailsEnabled             Boolean @default(true)
  // Whether admins get the shortfall digests (one per period, not per member).
  // Independent switches: a daily digest is a nudge, a weekly one is a review,
  // and orgs reasonably want the second without the first.
  notifyDailyShortfall      Boolean @default(true)
  notifyWeeklyShortfall     Boolean @default(true)
  notifyUnusualActivity     Boolean @default(true)
  // Off by default: the only one of these that mails every member rather than
  // the admins, so it is opted into rather than sprung on a workspace.
  notifyMemberWeeklySummary Boolean @default(false)
  users         User[]
  projects      Project[]
  invites       InviteToken[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model User {
  id                 String            @id @default(uuid()) @db.Uuid
  orgId              String            @db.Uuid
  org                Organization      @relation(fields: [orgId], references: [id])
  email              String            @unique
  passwordHash       String?
  name               String?
  role               Role              @default(member)
  status             UserStatus        @default(invited)
  consentAcceptedAt  DateTime?
  consentVersion     Int?
  // Per-member overrides. Null means "inherit the org target" — distinct from 0,
  // which is a real target of no hours (someone on leave).
  dailyTargetMinutes  Int?
  weeklyTargetMinutes Int?
  createdAt          DateTime          @default(now())
  devices            Device[]
  sessions           TrackingSession[]
  notifications      Notification[]
  timeNotes          TimeNote[]
  deletedScreenshots Screenshot[]      @relation("ScreenshotDeletedBy")
  passwordResets     PasswordResetToken[]
  projectMemberships ProjectMember[]
  auditLogs          AuditLog[]        @relation("AuditLogActor")

  @@index([orgId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model InviteToken {
  id         String       @id @default(uuid()) @db.Uuid
  orgId      String       @db.Uuid
  org        Organization @relation(fields: [orgId], references: [id])
  email      String
  role       Role
  token      String       @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([orgId])
}

model Project {
  id         String            @id @default(uuid()) @db.Uuid
  orgId      String            @db.Uuid
  org        Organization      @relation(fields: [orgId], references: [id])
  name       String
  clientTag  String?
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  tasks      Task[]
  sessions   TrackingSession[]
  members    ProjectMember[]

  @@index([orgId])
}

// Who a project is visible to. Owner/admin see every project regardless of
// this table — it exists to scope MEMBER visibility, not to gate admins.
model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id])
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Task {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @db.Uuid
  project   Project           @relation(fields: [projectId], references: [id])
  title     String
  status    TaskStatus        @default(todo)
  priority  TaskPriority      @default(normal)
  dueDate   DateTime?
  createdAt DateTime          @default(now())
  sessions  TrackingSession[]

  @@index([projectId])
}

model Device {
  id         String            @id @default(uuid()) @db.Uuid
  // Nullable + SetNull so deleting a member does not have to destroy the
  // hardware record its sessions still point at. Note a device has no path to
  // an org except through its user, so an orphaned row is unanchored — that is
  // tolerable because only /insights/presence reads devices, and it reads them
  // off User, so a deleted person's devices correctly stop appearing.
  userId     String?           @db.Uuid
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform   String
  appVersion String
  lastSeenAt DateTime          @default(now())
  createdAt  DateTime          @default(now())
  sessions   TrackingSession[]

  @@index([userId])
}

model TrackingSession {
  id              String            @id @default(uuid()) @db.Uuid
  // Nullable + SetNull: hard-deleting a member must not destroy the work they
  // tracked. An orphaned session keeps every field except its owner, and is
  // reached org-wide through `project.orgId` instead (TrackingSession carries
  // no orgId of its own) — see the org-scope clauses in reports/screenshots/
  // insights, which admit `{ userId: null, project: { orgId } }` for exactly
  // this reason.
  userId          String?           @db.Uuid
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId       String            @db.Uuid
  project         Project           @relation(fields: [projectId], references: [id])
  taskId          String?           @db.Uuid
  task            Task?             @relation(fields: [taskId], references: [id])
  deviceId        String            @db.Uuid
  device          Device            @relation(fields: [deviceId], references: [id])
  startedAt       DateTime
  endedAt         DateTime?
  endReason       SessionEndReason?
  isManual        Boolean           @default(false)
  manualReason    String?
  tamperSuspected Boolean           @default(false)
  // Last time this session's device successfully synced. The server-witnessed
  // elapsed cap is measured from here, so it must be set from the server clock
  // only — never from anything the client sends.
  lastSyncAt      DateTime?
  createdAt       DateTime          @default(now())
  activityBlocks  ActivityBlock[]
  screenshots     Screenshot[]
  flags           UnusualActivityFlag[]
  appUsages       AppUsage[]
  urlUsages       UrlUsage[]
  idleDiscards    IdleDiscard[]
  notes           TimeNote[]

  @@index([userId])
  @@index([projectId])
  @@index([deviceId])
}

model AppUsage {
  id         String          @id @default(uuid()) @db.Uuid
  sessionId  String          @db.Uuid
  session    TrackingSession @relation(fields: [sessionId], references: [id])
  appName    String
  seconds    Int
  blockStart DateTime
  createdAt  DateTime        @default(now())

  @@unique([sessionId, blockStart, appName])
  @@index([sessionId])
}

model UrlUsage {
  id         String          @id @default(uuid()) @db.Uuid
  sessionId  String          @db.Uuid
  session    TrackingSession @relation(fields: [sessionId], references: [id])
  domain     String
  seconds    Int
  blockStart DateTime
  createdAt  DateTime        @default(now())

  @@unique([sessionId, blockStart, domain])
  @@index([sessionId])
}

model IdleDiscard {
  id        String          @id @default(uuid()) @db.Uuid
  sessionId String          @db.Uuid
  session   TrackingSession @relation(fields: [sessionId], references: [id])
  from      DateTime
  to        DateTime
  seconds   Int
  createdAt DateTime        @default(now())

  @@index([sessionId])
}

model TimeNote {
  id        String          @id @default(uuid()) @db.Uuid
  sessionId String          @db.Uuid
  session   TrackingSession @relation(fields: [sessionId], references: [id])
  // Nullable + SetNull for the same reason as TrackingSession: the note is part
  // of the tracked record and outlives its author.
  userId    String?         @db.Uuid
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime        @default(now())

  @@index([sessionId])
}

model ActivityBlock {
  id          String          @id @default(uuid()) @db.Uuid
  sessionId   String          @db.Uuid
  session     TrackingSession @relation(fields: [sessionId], references: [id])
  blockStart  DateTime
  blockEnd    DateTime
  keyboardPct Float
  mousePct    Float
  activityPct Float
  idleSeconds Int             @default(0)
  sequenceNo  Int
  prevHash    String
  hash        String
  // Monotonic timing from the client's tamper-resistant clock. `creditedSeconds`
  // is awake time only and is immune to system-clock changes; `suspendedSeconds`
  // is time asleep (recorded, never credited); `clockSkewSeconds` is how far the
  // wall clock drifted against the monotonic counter. Nullable for blocks synced
  // by clients predating this.
  creditedSeconds  Int?
  suspendedSeconds Int?
  clockSkewSeconds Int?
  // The pause definition (in seconds) this block's activityPct was measured
  // with — how long one input event keeps counting as work. NULL means the
  // original per-second sampling, where only a second containing an actual
  // event counted. Stored so every figure says how it was produced, and so a
  // report spanning the change can say the two halves are not comparable
  // instead of silently averaging them. Never used to recompute a stored
  // percentage: activityPct is inside the hash chain and is not ours to edit.
  pauseDefinitionSecs Int?
  createdAt   DateTime        @default(now())
  screenshots Screenshot[]

  @@unique([sessionId, sequenceNo])
  @@index([sessionId])
}

model Screenshot {
  id              String        @id @default(uuid()) @db.Uuid
  sessionId       String        @db.Uuid
  session         TrackingSession @relation(fields: [sessionId], references: [id])
  activityBlockId String        @db.Uuid
  activityBlock   ActivityBlock @relation(fields: [activityBlockId], references: [id])
  takenAt         DateTime
  monitorIndex    Int
  r2Key           String
  blurred         Boolean       @default(false)
  deletedAt       DateTime?
  deletedById     String?       @db.Uuid
  // Optional already, but an unspecified action still defaults to Restrict —
  // so without this an admin who had ever deleted a screenshot could not
  // themselves be deleted.
  deletedBy       User?         @relation("ScreenshotDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  @@index([sessionId])
  @@index([activityBlockId])
  // Gallery paging is a keyset scan on (takenAt desc, id desc) — without this
  // every page is a full sort of the org's screenshot history.
  @@index([takenAt, id])
  // The R2 key is deterministic (org/session/takenAtMs-mN.webp), so it names one
  // image exactly once. Unique because a confirm whose response was lost is
  // retried by the client, and without this the retry created a second row for
  // an object already stored — the same screenshot twice in the gallery.
  @@unique([r2Key])
}

model UnusualActivityFlag {
  id             String          @id @default(uuid()) @db.Uuid
  sessionId      String          @db.Uuid
  session        TrackingSession @relation(fields: [sessionId], references: [id])
  type           FlagType
  detectedAt     DateTime        @default(now())
  details        Json?
  acknowledgedAt DateTime?

  @@index([sessionId])
}

model Notification {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @db.Uuid
  org       Organization @relation(fields: [orgId], references: [id])
  userId    String?      @db.Uuid
  // Same trap as Screenshot.deletedBy: optional, but Restrict by default, so a
  // member with any notification about them could not be deleted.
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime     @default(now())

  @@index([orgId])
  @@index([userId])
}

// Org-wide trail of destructive and membership actions: who did what, to whom,
// when. Deliberately shaped like Notification — a required `orgId` as the
// durable anchor and an optional actor — because the whole point of this table
// is to outlive the people in it.
//
// The readable identity of both sides lives in `payload` (actorEmail,
// targetEmail, targetLabel), NEVER read back through the `actor` relation. That
// is what keeps an entry meaningful after the account it describes has been
// hard-deleted, and it mirrors what notifyOrg() already does with
// Notification.payload.memberEmail.
model AuditLog {
  id        String       @id @default(uuid()) @db.Uuid
  orgId     String       @db.Uuid
  org       Organization @relation(fields: [orgId], references: [id])
  // SetNull, not the implicit Restrict: an audit row must never be the reason a
  // user delete fails, and must never be removed alongside them.
  actorId   String?      @db.Uuid
  actor     User?        @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  payload   Json?
  createdAt DateTime     @default(now())

  // Every read is org-scoped and ordered by createdAt desc (cursor paging);
  // the second index serves the action filter.
  @@index([orgId, createdAt])
  @@index([orgId, action])
}
